{
  "name": "@linxin666/dsh-prompt-enhancer",
  "version": "0.3.0",
  "description": "DSH Web UI 双引擎：✨ 提示词增强器（草稿改写 + 方向选项）与 🧭 参谋方向引擎（一句话想法 → 可审查/可比较/可迭代的局势模型 + 缩进树视图 + 选定方向导出提示词）。Host 侧用本地已配置的模型，支持续研增量更新与手动复查。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT"
}
