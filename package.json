{
  "name": "@linxin666/dsh-prompt-enhancer",
  "version": "0.2.0",
  "description": "DSH Web UI 提示词增强器：输入框工具行 ✨ 按钮一键生成清晰提示词；候选框支持方向键/数字键、生成后切换模型，并把「该由你拍板」的点做成方向选项框 + 效果方向缩进树；Host 侧用本地已配置的 flash 模型改写。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT"
}
